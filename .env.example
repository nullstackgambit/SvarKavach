# SvarKavach configuration. Copy to .env and edit.
#   cp .env.example .env
# Every value below is optional; the defaults shown are what the app uses.

# ---- application ----
APP_NAME=SvarKavach
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# ---- detector ----
# mock              simulated scores, no model download needed (demo only)
# xlsr_aasist_onnx  XLS-R-300M + AASIST via ONNX Runtime  (recommended)
# xlsr_aasist_torch XLS-R-300M + AASIST via PyTorch       (needs requirements-torch.txt)
DETECTOR_PROVIDER=mock

# auto | cpu | cuda.  'auto' uses CUDA when the runtime exposes it.
MODEL_DEVICE=auto

# Leave empty to use models/spectra_aasist/spectra-aasist.onnx
MODEL_PATH=

# 0 = let the inference runtime choose the thread count.
INFERENCE_THREADS=0

# Softmax temperature applied to the raw logits. 1.0 = plain softmax.
# Raise it to soften over-confident scores once you have calibration data.
CALIBRATION_TEMPERATURE=1.0

# If the requested real detector fails to load, may the app fall back to mock?
# Default false: a requested real detector fails loudly rather than silently
# degrading to simulated inference.
ALLOW_DETECTOR_FALLBACK=false

# ---- mock detector (ignored unless DETECTOR_PROVIDER=mock) ----
MOCK_BASE_SCORE=0.5
MOCK_SPREAD=0.35
MOCK_LATENCY_MS=90.0

# ---- audio / preprocessing ----
TARGET_SAMPLE_RATE=16000
# 4.0375 s = 64,600 samples, the model's native input length.
WINDOW_SECONDS=4.0375
HOP_SECONDS=0.5
VAD_ENABLED=true
VAD_MODEL_PATH=
VAD_THRESHOLD=0.5
# Minimum speech inside a window before it is worth scoring.
# This is the most important knob for LIVE capture: the detector reads
# digital-silence padding as a spoofing artefact, so windows that are mostly
# silence score high. See README section 17 for the measured relationship.
# Too low -> false positives on quiet stretches. Too high -> every window
# abstains. Tune against representative audio.
MIN_SPEECH_SECONDS=1.5

# ---- quality gates (abstention) ----
MIN_RMS_DBFS=-55.0
MAX_CLIPPING_RATIO=0.02

# ---- scoring ----
SMOOTHING_ALPHA=0.35
# Sustained evidence: k of the last m windows must exceed the verify threshold
# before the state may rise above WATCH.
SUSTAINED_K=3
SUSTAINED_M=5

# ---- risk thresholds (demonstration defaults, not validated) ----
WATCH_THRESHOLD=0.40
VERIFY_THRESHOLD=0.65
ESCALATE_THRESHOLD=0.85

# ---- demo context weighting ----
HIGH_VALUE_TRANSACTION=1000000
HIGH_VALUE_MULTIPLIER=0.10
UNKNOWN_CONTACT_MULTIPLIER=0.05

# ---- limits ----
MAX_SESSION_SECONDS=900
MAX_CHUNK_BYTES=262144
MAX_CONCURRENT_SESSIONS=16

# ---- live system audio capture (loopback) ----
# Captures whatever is playing through this machine's output device, so the
# dashboard can analyse a live call instead of a recording.
#
# SECURITY: this application has no authentication. With this enabled, ANY
# client that can reach the server can start recording this machine's audio.
# Serve it on 127.0.0.1 only, or put authentication and TLS in front of it.
#
# Requires the optional extra:  pip install -r requirements-audio.txt
#   Linux   - needs PulseAudio or pipewire-pulse (a "monitor" source)
#   Windows - uses WASAPI loopback, nothing extra needed
#   macOS   - no native loopback; needs a virtual device such as BlackHole
SYSTEM_AUDIO_ENABLED=false

# Empty = the first available loopback device.
SYSTEM_AUDIO_DEVICE=

# Capture block size in milliseconds, and the bounded backlog before the
# oldest block is dropped.
SYSTEM_AUDIO_BLOCK_MS=100
SYSTEM_AUDIO_QUEUE_BLOCKS=50

# ---- privacy ----
# Opt-in debug audio persistence. Leave false: no audio touches the disk.
PERSIST_AUDIO_DEBUG=false
